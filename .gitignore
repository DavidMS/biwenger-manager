# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Claude Code personal overrides
.claude/settings.local.json
# Maven wrapper jar must stay committed despite *.jar above
!**/.mvn/wrapper/maven-wrapper.jar

# Secrets: Biwenger credentials live only in .env (see CLAUDE.md). Commit .env.example instead.
.env
.env.*
!.env.example
secrets/

# Build output
target/
node_modules/
dist/
coverage/
frontend/playwright-report/
frontend/test-results/

# IDE and OS files
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
