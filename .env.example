# Copy to .env and fill in: `cp .env.example .env`.
# .env is gitignored and must never be committed. Claude Code is blocked from reading it.

# --- Biwenger account (used from Phase 2) ---------------------------------------------
# The email and password you log in to https://biwenger.as.com with. They stay on this
# machine: only the backend reads them, to log in to the Biwenger API.
BIWENGER_EMAIL=
BIWENGER_PASSWORD=

# Daily sync: when the backend reads the catalog, market and standings from Biwenger and stores
# today's snapshot. Spring cron (second minute hour day month weekday), Madrid time. Default 07:30,
# half an hour after the market closes. It only reads; nothing in your account changes.
BIWENGER_SYNC_CRON=0 30 7 * * *
# false turns the daily sync off.
BIWENGER_SYNC_ENABLED=true
# true imports this season's price history and match points for every player, once, in the
# background after the backend starts: about 1,100 requests to Biwenger's public CDN, ~10 minutes.
# It resumes if interrupted and does nothing once finished, so it can stay on.
BIWENGER_BACKFILL_ENABLED=false

# --- Database (PostgreSQL in Docker) -----------------------------------------------------
POSTGRES_DB=biwenger
POSTGRES_USER=biwenger
# Required: docker compose refuses to start until you set it. Any value works for this
# local database; pick something that isn't a password you use elsewhere.
POSTGRES_PASSWORD=
# Port on this machine for local tools (psql, an IDE). Bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# --- App -------------------------------------------------------------------------------------
# Port on this machine where the UI is served: http://localhost:8000
APP_PORT=8000
